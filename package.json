{
  "name": "flashpass",
  "version": "1.0.0",
  "private": true,
  "description": "High-Throughput Distributed Flash-Sale & Inventory Engine",
  "scripts": {
    "install:all": "npm install --prefix frontend && npm install --prefix backend",
    "build:frontend": "npm --prefix frontend run build",
    "build:backend": "npm --prefix backend run build",
    "build": "npm run install:all && npm run build:frontend && npm run build:backend",
    "start": "node backend/dist/index.js",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
