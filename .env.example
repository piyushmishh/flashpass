# ─────────────────────────────────────────────────
# FlashPass — Environment Configuration
# Copy this to .env and adjust values as needed.
# ─────────────────────────────────────────────────

# Server
NODE_ENV=development
PORT=4000

# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=flashpass
POSTGRES_USER=flashpass_admin
POSTGRES_PASSWORD=supersecret_fp_2026

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# Kafka
KAFKA_BROKERS=kafka:9092
KAFKA_CLIENT_ID=flashpass-backend

# JWT
JWT_SECRET=change-me-to-a-real-secret-in-production-please
JWT_EXPIRY=24h

# Reservation settings
RESERVATION_TTL_SECONDS=600
MAX_TICKETS_PER_USER=2
